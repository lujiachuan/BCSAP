record(calc, "Part1:Flow_R:CS200A:InstantSCCM") {
    field(DESC, "gas.ar.flow_readback")
    field(INPA, "Part1:Flow_W:CS200A:Setpoint CP")
    field(CALC, "A")
    field(EGU,  "sccm")
    field(PREC, "6")
}

